@startuml
left to right direction
actor "Бухгалтер" as accountant
actor "Руководитель" as manager
rectangle "FinTrack" {
  usecase "Авторизация" as auth
  usecase "Просмотр операций" as view_ops
  usecase "Поиск операций" as search_ops
  usecase "Просмотр отчётов" as view_reports
  usecase "Просмотр доходов, расходов и прибыли" as view_totals
  usecase "Добавить доход" as add_income
  usecase "Добавить расход" as add_expense
  usecase "Редактировать операцию" as edit_op
  usecase "Удалить операцию" as delete_op
  usecase "Сформировать отчёт" as make_report
  usecase "Рассчитать показатели" as calculate
}
accountant -- auth
accountant -- view_ops
accountant -- search_ops
accountant -- view_reports
accountant -- view_totals
manager -- auth
manager -- view_ops
manager -- search_ops
manager -- view_reports
manager -- view_totals
accountant -- add_income
accountant -- add_expense
accountant -- edit_op
accountant -- delete_op
accountant -- make_report
make_report ..> calculate : <<include>>
@enduml
